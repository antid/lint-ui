{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lint UI Configuration",
  "description": "Configuration schema for Lint UI visual regression and compliance testing",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl", "routes"],
  "properties": {
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "The base URL of the application to test"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "description": "List of routes to test",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Route path (e.g., /, /dashboard)"
          },
          "name": {
            "type": "string",
            "description": "Friendly name for the route"
          },
          "waitFor": {
            "type": "string",
            "description": "CSS selector to wait for, or 'networkidle'"
          }
        }
      }
    },
    "breakpoints": {
      "type": "array",
      "minItems": 1,
      "description": "Viewport breakpoints to test",
      "default": [
        { "name": "mobile", "width": 375, "height": 812 },
        { "name": "tablet", "width": 768, "height": 1024 },
        { "name": "desktop", "width": 1280, "height": 800 },
        { "name": "large", "width": 1440, "height": 900 }
      ],
      "items": {
        "type": "object",
        "required": ["name", "width"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Breakpoint name"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "description": "Viewport width in pixels"
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "description": "Viewport height in pixels"
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Visual comparison thresholds",
      "properties": {
        "pixelThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "pixelmatch sensitivity; lower values detect smaller color differences"
        },
        "maxDiffPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0.1,
          "description": "Maximum percentage of changed pixels allowed before failure"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Controls that make page capture deterministic",
      "properties": {
        "navigationTimeoutMs": { "type": "integer", "minimum": 1, "default": 30000 },
        "readinessTimeoutMs": { "type": "integer", "minimum": 1, "default": 10000 },
        "imageTimeoutMs": { "type": "integer", "minimum": 1, "default": 10000 },
        "maskSelectors": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "readySelector": {
      "type": "string",
      "description": "CSS selector indicating the page is ready for testing"
    },
    "disableAnimations": {
      "type": "boolean",
      "default": true,
      "description": "Disable animations during tests"
    },
    "outputDir": {
      "type": "string",
      "default": ".lint-ui",
      "description": "Directory for test output"
    },
    "baselineDir": {
      "type": "string",
      "default": ".ui-baseline",
      "description": "Directory for baseline screenshots"
    }
  }
}
