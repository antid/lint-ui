{
  "name": "lint-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Visual regression and UI compliance testing for modern web applications",
  "keywords": [
    "visual-regression",
    "accessibility",
    "ui-testing",
    "compliance",
    "ci"
  ],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.9"
  }
}
